APP_NAME=PWA Autonomía Económica Femenina
APP_ENV=development
DATABASE_URL=mysql+pymysql://pwa_app:change_me@localhost:3306/pwa_autonomia?charset=utf8mb4
DATABASE_ADMIN_URL=mysql+pymysql://root:change_root@localhost:3306/pwa_autonomia?charset=utf8mb4
CONTENT_ENCRYPTION_KEY=replace-with-a-fernet-key
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUDIO_MAX_RETENTION_HOURS=24
SOFT_DELETE_PURGE_DAYS=30
AUDIT_RETENTION_DAYS=365
SECURITY_LOG_RETENTION_DAYS=90
DEFAULT_CURRENCY=BOB
DEFAULT_TIMEZONE=America/La_Paz
